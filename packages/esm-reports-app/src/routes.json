{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0",
    "reportingrest": ">=1.15.0",
    "reporting": ">=1.27.0"
  },
  "extensions": [
    {
      "name": "admin-report-link",
      "slot": "system-admin-page-card-link-slot",
      "component": "reportsLink"
    },
    {
      "name": "run-report",
      "component": "runReport"
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "reports"
    }
  ],
  "modals": [
    {
      "name": "cancel-report-modal",
      "component": "cancelReportModal"
    },
    {
      "name": "report-export-columns-modal",
      "component": "reportExportColumnsModal"
    }
  ]
}
