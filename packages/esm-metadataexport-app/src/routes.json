{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "metadataexport": ">=1.0.0-SNAPSHOT"
  },
  "pages": [
    {
      "route": "metadataexport",
      "component": "root",
      "online": true
    }
  ],
  "extensions": [
    {
      "name": "metadata-export-card-link",
      "slot": "system-admin-page-card-link-slot",
      "component": "metadataExportCardLink",
      "privileges": ["Get Metadata Export Packages"]
    }
  ],
  "modals": [
    {
      "name": "delete-metadata-package-modal",
      "component": "deleteMetadataPackageModal"
    }
  ],
  "workspaceGroups2": [
    {
      "name": "metadata-export-group",
      "scopePattern": "^/metadataexport",
      "overlay": true
    }
  ],
  "workspaceWindows2": [
    {
      "name": "metadata-package-form-window",
      "group": "metadata-export-group",
      "canMaximize": true,
      "width": "narrow"
    },
    {
      "name": "view-metadata-package-window",
      "group": "metadata-export-group",
      "canMaximize": true,
      "width": "narrow"
    }
  ],
  "workspaces2": [
    {
      "name": "metadata-package-form-workspace",
      "component": "metadataPackageFormWorkspace",
      "window": "metadata-package-form-window"
    },
    {
      "name": "view-metadata-package-workspace",
      "component": "viewMetadataPackageWorkspace",
      "window": "view-metadata-package-window"
    }
  ]
}
